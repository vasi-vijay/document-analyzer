# Copy to .env and replace secrets before use. Never commit .env.
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=replace-with-a-long-random-password

# Keep this name consistent with application.properties.
POSTGRE_DB_PASSWORD=replace-with-your-local-db-password

# Choose: ollama or openai
APP_AI_PROVIDER=ollama

# Local or remote Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hosted OpenAI or OpenAI-compatible endpoint (LM Studio, vLLM, gateway)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Retrieval / ingestion
APP_AI_MAX_CONTEXT_CHUNKS=6
APP_AI_MIN_LEXICAL_SCORE=0.08
APP_INGESTION_CHUNK_SIZE=1200
APP_INGESTION_CHUNK_OVERLAP=180
APP_INGESTION_MAX_EXTRACTED_CHARS=2000000

# Upload and storage
APP_UPLOAD_MAX_SIZE=25MB
APP_UPLOAD_MAX_BYTES=26214400
APP_STORAGE_ROOT=./var/documents

# Local stack defaults. Override these when using an existing/external DB.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vasivijay
SPRING_DATASOURCE_USERNAME=docanalyzer
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
